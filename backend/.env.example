APP_NAME="Student Skill Gap Analyzer"
ENVIRONMENT="development"

# Database Connection:
# For local development: sqlite:///./app.db
# For production (Render PostgreSQL): postgresql://user:password@host:port/dbname
DATABASE_URL="sqlite:///./app.db"

# JWT Authentication (7-day default session expiry):
JWT_SECRET="replace_with_a_long_random_secret_in_production"
ACCESS_TOKEN_EXPIRE_MINUTES=10080
FRONTEND_ORIGIN="http://localhost:5173"

# Optional Email / Password Reset Service (SMTP):
# When omitted, reset links print to backend server logs in development.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="your-email@gmail.com"
# SMTP_PASSWORD="your-app-password"
# SMTP_FROM_EMAIL="noreply@skillanalyzer.dev"
